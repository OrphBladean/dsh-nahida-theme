{
  "name": "dsh-nahida-theme",
  "version": "0.2.0",
  "description": "纳西妲主题：草元素绿意配色 + 四叶草徽记 + 祝福语 + 飘落叶片 + 可自选的聊天区壁纸｜A Nahida theme for the DeepSeek Harness (DSH) Web GUI, with a four-leaf-clover mark and selectable chat wallpapers. Made with DSH.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./assets/*": "./lib/assets/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "files": [
    "lib/*.js",
    "lib/assets",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "test",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "nahida",
    "dendro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrphBladean/dsh-nahida-theme.git"
  },
  "homepage": "https://github.com/OrphBladean/dsh-nahida-theme#readme",
  "bugs": {
    "url": "https://github.com/OrphBladean/dsh-nahida-theme/issues"
  },
  "author": "OrphBladean",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
